# =============================================================================
# Bitestream — Docker Compose environment (Phase 1)
# Copy to .env:  cp .env.example .env
# =============================================================================

# --- Compose / project ---
COMPOSE_PROJECT_NAME=bitestream

# --- Container images (pin versions for reproducibility) ---
KAFKA_IMAGE=confluentinc/cp-kafka:7.9.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# --- Docker DNS hostnames (used by other containers on bitestream-net) ---
KAFKA_HOSTNAME=bitestream-kafka
KAFKA_UI_HOSTNAME=bitestream-kafka-ui
KAFKA_INIT_HOSTNAME=bitestream-kafka-init-topics

# --- Host port mappings (change only if you have local conflicts) ---
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080

# --- Kafka internal listener ports (leave default unless customizing networking) ---
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093

# --- KRaft cluster identity ---
# Generate a new ID: docker run --rm confluentinc/cp-kafka:7.9.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_CLUSTER_NAME=bitestream-cluster

# --- Single-broker replication (required for a one-broker cluster) ---
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# --- Kafka broker tuning (dev-friendly defaults) ---
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# --- Kafka topic bootstrap settings ---
FOOD_DELIVERY_EVENTS_TOPIC=food_delivery_events
FOOD_DELIVERY_EVENTS_PARTITIONS=3
FOOD_DELIVERY_EVENTS_REPLICATION_FACTOR=1
KAFKA_READY_BROKER_COUNT=1
KAFKA_READY_TIMEOUT_SECONDS=60

# --- Docker resources ---
DOCKER_NETWORK_NAME=bitestream-net
KAFKA_DATA_VOLUME_NAME=bitestream-kafka-data
