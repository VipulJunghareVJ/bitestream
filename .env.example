# Copy to .env and fill in values

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data lake
DATA_ROOT=data

# Kafka (broker exposed by docker/docker-compose.yml — see docker/.env.example)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=bitestream
KAFKA_TOPIC=food_delivery_events
KAFKA_CONSUMER_GROUP=bitestream-consumer

# Spark
SPARK_APP_NAME=bitestream
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8

# Warehouse / GCP
GCP_PROJECT=
BIGQUERY_DATASET=bitestream
GOOGLE_APPLICATION_CREDENTIALS=

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
